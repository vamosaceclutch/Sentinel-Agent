# Copy this file to ".env" and fill in your own values. Never commit ".env".
GEMINI_API_KEY=your-gemini-api-key
# Private key of the AGENT wallet (the only address allowed to write to the registry).
# Use a testnet-only wallet. Never put a key that holds real funds here.
AGENT_PRIVATE_KEY=0x...
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
